{
  "framework": null,
  "installCommand": "corepack pnpm install --frozen-lockfile --ignore-scripts",
  "functions": {
    "api/github.ts": {
      "maxDuration": 300
    },
    "api/review-jobs.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "oddmash-review-jobs"
        }
      ]
    },
    "api/advisory.ts": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "pnpm --filter @oddmash/agents-console build",
  "outputDirectory": "apps/console/dist",
  "rewrites": [
    {
      "source": "/:locale(en|ko)",
      "destination": "/index.html"
    },
    {
      "source": "/:locale(en|ko)/:view(overview|activity|contributors|usage|settings)",
      "destination": "/index.html"
    }
  ]
}
